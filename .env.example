# Modele des variables d'environnement.
# Copier ce fichier en .env.local, puis remplir les valeurs.
# Ne jamais commiter .env.local. Aucune valeur reelle ne doit figurer ici.

# Base de donnees (etape 7)
DATABASE_URL=
DATABASE_URL_MIGRATION=

# Authentification (etape 8)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Envoi d'emails (fonctionnalite 0.7, docs/features/envoi-emails.md, section 2.2).
# Toutes facultatives en local : sans elles, les emails sont ecrits dans .emails/
# (transport fichier) et rien n'est envoye. Lignes en commentaire : une variable
# presente mais vide est refusee au demarrage.
# EMAIL_TRANSPORT : memoire ou fichier.
# EMAIL_DESTINATAIRES_AUTORISES : adresses separees par des virgules ; hors
# production, aucun envoi hors de cette liste.
# EMAIL_DOSSIER : dossier du transport fichier (par defaut .emails).
#
# ATTENTION : ne jamais mettre de variable Gmail (GMAIL_UTILISATEUR,
# GMAIL_MOT_DE_PASSE_APPLICATION) dans .env.local. npm run test:e2e lance
# next start, qui charge .env.local : un test de bout en bout pourrait envoyer
# un vrai email. Le mot de passe d'application ne vit que dans Vercel.
# EMAIL_TRANSPORT=
# EMAIL_DESTINATAIRES_AUTORISES=
# EMAIL_DOSSIER=

# Tache quotidienne (fonctionnalite 8.3, docs/features/tache-quotidienne.md).
# CRON_SECRET : Vercel seulement (Production et Preview, type Secret), jamais
# ici ni dans .env.local. En local, absente : la tache refuse tout appel.
# CRON_SECRET=
