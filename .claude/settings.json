{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./drizzle/**)",
      "Edit(./src/db/auth-schema.ts)",
      "Bash(*.env.local*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(npm audit fix*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(node scripts/renouveler-mot-de-passe-app.mjs*)",
      "Bash(node scripts/preparer-url-application.mjs*)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npx *)",
      "Bash(npm run db:generate*)",
      "Bash(npm run db:migrate*)",
      "Bash(git commit*)",
      "Bash(git push*)"
    ],
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test:e2e*)",
      "Bash(npm audit)",
      "Bash(npm audit --omit=dev)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(node scripts/verifier-*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/apres-modification.mjs"
          }
        ]
      }
    ]
  }
}
