{
  "name": "facturation-pme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run --project unitaires",
    "test:watch": "vitest --project unitaires",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node scripts/e2e-base-jetable.mjs",
    "format:check": "prettier --check .",
    "verifier:auth": "tsx --conditions=react-server scripts/verifier-auth.mts",
    "verifier:creation-auth": "tsx --conditions=react-server scripts/verifier-creation-auth.mts",
    "essai:email": "tsx --conditions=react-server scripts/essai-envoi-gmail.mts",
    "verifier": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e && node scripts/verifier-ports.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-react": "1.54.0",
    "next": "16.4.0",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.6",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.9",
    "shadcn": "4.21.4",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
